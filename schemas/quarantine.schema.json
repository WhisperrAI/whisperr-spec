{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WhisperrAI/whisperr-spec/main/schemas/quarantine.schema.json",
  "title": "Whisperr error and quarantine taxonomy 2.0.0",
  "$defs": {
    "disposition": {
      "enum": ["completed", "retrying", "quarantined", "dead_lettered", "suppressed"],
      "description": "Every ACKNOWLEDGED delivery is in exactly one of these. Never silently missing."
    },
    "rejection_code": {
      "enum": ["signature_invalid", "timestamp_out_of_window", "payload_too_large", "content_type_invalid", "contract_version_unsupported"],
      "description": "Refused BEFORE acknowledge. Nothing durable is written."
    },
    "quarantine_code": {
      "enum": ["identity_conflict", "unregistered_event_code", "schema_violation", "mapping_ambiguous", "catalog_reference_invalid", "consent_missing_for_required_channel"]
    },
    "retry_code": { "enum": ["transient_provider_error", "rate_limited", "downstream_unavailable", "lease_lost"] },
    "dead_letter_code": {
      "enum": ["retry_exhausted", "permanently_malformed", "derived_event_code", "contact_change_requires_server_key"],
      "description": "derived_event_code and contact_change_requires_server_key are SDK-ingestion rejections decided after the 202 acknowledge (contracts/09)."
    },
    "suppression_code": {
      "enum": ["test_mode", "consent_blocked", "catalog_uncertain", "expired", "intervention_paused", "intervention_resolved", "billing_state_changed", "messaging_paused", "audience_excluded", "recipient_not_identified", "recipient_user_limit", "live_channel_missing", "live_channel_disabled", "channel_day_cap_reached", "channel_week_cap_reached", "quiet_hours", "below_sms_priority_threshold"],
      "description": "Intentional and NOT a failure. Counted and visible, never reported as an error. The codes after intervention_paused come from send-time checks that run just before a relay send (contracts/09)."
    },
    "entry": {
      "type": "object",
      "required": ["disposition", "code", "connection_id", "replayable"],
      "additionalProperties": false,
      "properties": {
        "disposition": { "$ref": "#/$defs/disposition" },
        "code": { "type": "string", "minLength": 1 },
        "connection_id": { "type": "string" },
        "occurrence_refs": { "type": "array", "items": { "type": "string" } },
        "smallest_repair_action": { "type": ["string", "null"] },
        "replayable": { "type": "boolean" },
        "occurred_at": { "type": "string" }
      },
      "allOf": [{
        "if": { "properties": { "disposition": { "const": "quarantined" } }, "required": ["disposition"] },
        "then": {
          "required": ["smallest_repair_action"],
          "properties": { "smallest_repair_action": { "type": "string", "minLength": 1 }, "replayable": { "const": true } },
          "description": "Every quarantine has a repair path AND a replay path. A quarantine with no way out is a bug, not a state."
        }
      }]
    }
  }
}
