{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WhisperrAI/whisperr-spec/main/schemas/automatic.schema.json",
  "title": "Whisperr automatic-event catalogue and conformance cases",
  "type": "object",
  "required": ["version", "commonProperties", "reserved", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "commonProperties": {
      "description": "Flat properties every automatic event carries when the runtime can supply them. No value, no key.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/property_name" },
      "additionalProperties": { "$ref": "#/$defs/property_spec" }
    },
    "reserved": {
      "description": "The reserved automatic event names. The server accepts each one for every app without registration.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reserved_event" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "pushEventsV2": {
      "description": "Contract v2 push-event flows (push_received, the v2 push_opened properties). Opt-in: an SDK that runs them skips the legacy cases listed in supersedes.",
      "type": "object",
      "required": ["description", "supersedes", "cases"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^automatic\\.json:[a-z0-9_]+$" }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/case_v2" }
        }
      }
    },
    "signalsV3": {
      "description": "Signals v3 flows (session_id, launch_source, per-visit counters, app_error, app_crashed). Opt-in per section, by appliesTo.",
      "type": "object",
      "required": ["description", "legacyStrip", "fingerprintVectors", "sections"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "legacyStrip": {
          "description": "What a signalsV3 harness removes from sent events before it compares a legacy case.",
          "type": "object",
          "required": ["events", "properties"],
          "additionalProperties": false,
          "properties": {
            "events": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/event_type" } },
            "properties": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/property_name" } }
          }
        },
        "fingerprintVectors": {
          "description": "app_error fingerprint test vectors: errorName and the already-stripped frame function names, top first.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["errorName", "frames", "fingerprint"],
            "additionalProperties": false,
            "properties": {
              "errorName": { "type": "string", "minLength": 1, "maxLength": 64 },
              "frames": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
            }
          }
        },
        "sections": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["description", "appliesTo", "cases"],
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "appliesTo": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["mobile", "web"] }
              },
              "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case_v3" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "event_type": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "property_name": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "property_spec": {
      "type": "object",
      "required": ["type", "description"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "integer", "boolean"] },
        "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required": { "type": "boolean" },
        "requiredIn": {
          "description": "Required in these contexts even though required is false: signalsV3 (every event an SDK that runs signalsV3 sends), mobile (every event a mobile SDK sends).",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["signalsV3", "mobile"] }
        },
        "placeholder": {
          "description": "A value the harness cannot control. Expected events carry this token, and the harness substitutes its SDK's own value.",
          "type": "string",
          "pattern": "^\\$[a-z_]+$"
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "reserved_event": {
      "type": "object",
      "required": ["name", "trigger", "automatic", "countsAsActivity", "properties"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/event_type" },
        "trigger": { "type": "string", "minLength": 1 },
        "automatic": {
          "description": "always: the SDK sends it on its own. framework: automatic only where the framework makes it cheap, otherwise a manual API. manual: the app calls an SDK method.",
          "enum": ["always", "framework", "manual"]
        },
        "countsAsActivity": {
          "description": "true when the event means the user did something in the app. The server counts only these as user activity.",
          "type": "boolean"
        },
        "properties": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/property_name" },
          "additionalProperties": { "$ref": "#/$defs/property_spec" }
        }
      }
    },
    "device": {
      "description": "What the harness makes the platform report. A missing key means the runtime cannot supply that value. platform, os_name, sdk_name and sdk_version are fixed by the SDK under test and appear as placeholders instead.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "osVersion": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "timezoneOffsetMinutes": { "type": "integer", "minimum": -720, "maximum": 840 }
      },
      "not": { "required": ["timezone", "timezoneOffsetMinutes"] }
    },
    "case": {
      "type": "object",
      "required": ["name", "device", "steps", "expectedEvents"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "storage": {
          "description": "empty (default): a fresh install. legacy_sdk_state: storage holds state an older SDK wrote (a stored user, no stored app version).",
          "enum": ["empty", "legacy_sdk_state"]
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "automaticEvents": { "type": "boolean" }
          }
        },
        "device": { "$ref": "#/$defs/device" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "expectedEvents": {
          "type": "array",
          "items": { "$ref": "#/$defs/expected_event" }
        }
      }
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "launch": {
          "description": "The process starts with this app version installed, the harness builds the client on the case storage, identifies user_1, and the app comes to the foreground (a cold start).",
          "type": "object",
          "required": ["appVersion", "appBuild"],
          "additionalProperties": false,
          "properties": {
            "appVersion": { "type": "string", "minLength": 1 },
            "appBuild": { "type": "string", "minLength": 1 }
          }
        },
        "background": {
          "description": "The harness clock moves forward afterMs, then the app goes to the background.",
          "$ref": "#/$defs/after"
        },
        "foreground": {
          "description": "The harness clock moves forward afterMs, then the app comes back to the foreground in the same process (a warm start).",
          "$ref": "#/$defs/after"
        },
        "terminate": {
          "description": "The process ends with no further lifecycle signal. Storage survives.",
          "const": true
        },
        "screen": {
          "description": "The app calls the SDK's manual screen API with this name.",
          "type": "string",
          "minLength": 1
        },
        "pushOpened": {
          "description": "The user opens a notification with this data payload, and the app hands it to the SDK's push-open API.",
          "type": "object"
        },
        "pushPermission": {
          "description": "The app reports this notification permission through the SDK's permission API.",
          "enum": ["authorized", "provisional", "denied", "not_determined"]
        },
        "reset": {
          "description": "The app calls reset() (logout).",
          "const": true
        },
        "optOut": {
          "description": "The app calls the SDK's opt-out API.",
          "const": true
        },
        "optIn": {
          "description": "The app calls the SDK's opt-in API.",
          "const": true
        }
      }
    },
    "case_v2": {
      "type": "object",
      "required": ["name", "device", "steps", "expectedEvents"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "storage": { "enum": ["empty", "legacy_sdk_state"] },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "automaticEvents": { "type": "boolean" }
          }
        },
        "device": { "$ref": "#/$defs/device" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step_v2" }
        },
        "expectedEvents": {
          "type": "array",
          "items": { "$ref": "#/$defs/expected_event_v2" }
        }
      }
    },
    "step_v2": {
      "description": "The legacy steps except pushOpened, plus receivePush and openPush.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "launch": { "$ref": "#/$defs/step/properties/launch" },
        "background": { "$ref": "#/$defs/after" },
        "foreground": { "$ref": "#/$defs/after" },
        "terminate": { "const": true },
        "screen": { "type": "string", "minLength": 1 },
        "pushPermission": { "enum": ["authorized", "provisional", "denied", "not_determined"] },
        "reset": { "const": true },
        "optOut": { "const": true },
        "optIn": { "const": true },
        "receivePush": {
          "description": "The device receives a push with this data payload on the receipt path named by source.",
          "type": "object",
          "required": ["data", "source", "foreground"],
          "additionalProperties": false,
          "properties": {
            "data": { "type": "object" },
            "source": { "enum": ["foreground", "nse", "android_service", "expo_task"] },
            "foreground": { "type": "boolean" }
          }
        },
        "openPush": {
          "description": "The user opens a notification with this data payload. actionId absent means a tap on the notification body.",
          "type": "object",
          "required": ["data", "launchedApp"],
          "additionalProperties": false,
          "properties": {
            "data": { "type": "object" },
            "actionId": { "type": "string", "minLength": 1 },
            "launchedApp": { "type": "boolean" }
          }
        }
      }
    },
    "expected_event_v2": {
      "description": "As expected_event, plus an optional context that lists the governed context keys the event must carry.",
      "type": "object",
      "required": ["event_type", "properties"],
      "additionalProperties": false,
      "properties": {
        "event_type": { "$ref": "#/$defs/event_type" },
        "properties": { "$ref": "#/$defs/expected_event/properties/properties" },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app_version": { "type": "string", "minLength": 1 },
            "app_build": { "type": "string", "minLength": 1 },
            "platform": { "const": "$platform" },
            "sdk_name": { "const": "$sdk_name" },
            "sdk_version": { "const": "$sdk_version" }
          }
        }
      }
    },
    "case_v3": {
      "type": "object",
      "required": ["name", "device", "steps", "expectedEvents"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "captureErrors": {
              "description": "false turns off automatic error capture; trackError still sends.",
              "type": "boolean"
            },
            "debugBuild": {
              "description": "true makes the SDK's debug-build check report a debug build.",
              "type": "boolean"
            }
          }
        },
        "device": { "$ref": "#/$defs/device" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step_v3" } },
        "expectedEvents": { "type": "array", "items": { "$ref": "#/$defs/expected_event_v3" } }
      }
    },
    "step_v3": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "launch": {
          "description": "Mobile: the process starts with this app version (appVersion and appBuild), optionally launched by via. Web: the page loads url.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "appVersion": { "type": "string", "minLength": 1 },
            "appBuild": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https?://" },
            "via": {
              "description": "The launch signals the SDK receives inside the attribution window.",
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "push": { "description": "Notification data, opened with a body tap that launched the app.", "type": "object" },
                "link": { "description": "The launch URL.", "type": "string", "minLength": 1 },
                "shortcut": { "description": "A home-screen quick action or app shortcut id.", "type": "string", "minLength": 1 }
              }
            }
          },
          "oneOf": [
            { "required": ["appVersion", "appBuild"], "not": { "required": ["url"] } },
            { "required": ["url"], "not": { "anyOf": [{ "required": ["appVersion"] }, { "required": ["via"] }] } }
          ]
        },
        "background": { "$ref": "#/$defs/after" },
        "foreground": { "$ref": "#/$defs/after" },
        "terminate": { "const": true },
        "screen": { "type": "string", "minLength": 1 },
        "track": {
          "description": "The app calls track(name) with no properties.",
          "$ref": "#/$defs/event_type"
        },
        "trackError": {
          "description": "The app calls trackError with an error of type name, and kind and screen when given.",
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "kind": { "enum": ["handled", "network", "screen"] },
            "screen": { "type": "string", "minLength": 1 }
          }
        },
        "uncaughtError": {
          "description": "The runtime's global handler sees an uncaught error of type name.",
          "type": "object",
          "required": ["name", "fatal"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "fatal": { "type": "boolean" }
          }
        }
      }
    },
    "expected_event_v3": {
      "description": "As expected_event, plus the session_id placeholder the event's context must carry.",
      "type": "object",
      "required": ["event_type", "properties", "context"],
      "additionalProperties": false,
      "properties": {
        "event_type": { "$ref": "#/$defs/event_type" },
        "properties": { "$ref": "#/$defs/expected_event/properties/properties" },
        "context": {
          "type": "object",
          "required": ["session_id"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string", "pattern": "^\\$session_[a-z]$" }
          }
        }
      }
    },
    "after": {
      "type": "object",
      "required": ["afterMs"],
      "additionalProperties": false,
      "properties": {
        "afterMs": { "type": "integer", "minimum": 0 }
      }
    },
    "expected_event": {
      "description": "An event as serialized, minus identity fields, occurred_at, and context (context must still carry $message_id, as wire.json pins).",
      "type": "object",
      "required": ["event_type", "properties"],
      "additionalProperties": false,
      "properties": {
        "event_type": { "$ref": "#/$defs/event_type" },
        "properties": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/property_name" },
          "additionalProperties": { "type": ["string", "integer", "boolean"] }
        }
      }
    }
  }
}
