{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WhisperrAI/whisperr-spec/main/schemas/catalog-feed.schema.json",
  "title": "Protected catalog snapshot feed 1.0",
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "source_item_id",
        "type",
        "name",
        "availability"
      ],
      "additionalProperties": false,
      "description": "The MINIMIZED offerable projection. Nothing from the source item beyond this is stored.",
      "properties": {
        "source_item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "type": {
          "enum": [
            "product",
            "plan",
            "content",
            "location",
            "offer"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "limited",
            "unavailable",
            "unknown"
          ],
          "description": "Becomes 'unknown' automatically past the connector's freshness threshold. 'unknown' and 'unavailable' are NEVER candidates."
        },
        "price": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "amount_minor",
            "currency"
          ],
          "additionalProperties": false,
          "properties": {
            "amount_minor": {
              "type": "integer",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "meaning": {
              "enum": [
                "list",
                "fixed",
                "from",
                "display_only"
              ]
            }
          }
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "location": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "source_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "references": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "localizations": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/localization"
          }
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "offer_terms": {
          "$ref": "#/$defs/offer_terms"
        }
      }
    },
    "action": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "view_item"
        },
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "product",
                "location",
                "offer",
                "plan",
                "content"
              ]
            },
            "id": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            },
            "location_id": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "type",
        "target"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "relation": {
          "enum": [
            "parent",
            "available_at",
            "applies_to",
            "product_source"
          ]
        },
        "source_item_id": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        }
      },
      "required": [
        "relation",
        "source_item_id"
      ],
      "additionalProperties": false
    },
    "localization": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "offer_terms": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "buy_x_get_y"
        },
        "buy_quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "free_quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "requires_membership": {
          "type": "boolean"
        },
        "eligibility": {
          "const": "conditional"
        },
        "summary": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "buy_quantity",
        "free_quantity",
        "requires_membership",
        "eligibility"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "source_item_id": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        },
        "message": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "snapshot_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        },
        "total_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        },
        "issues": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "required": [
        "schema_version",
        "snapshot_id",
        "generated_at",
        "total_items",
        "items",
        "complete",
        "next_cursor",
        "issues"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "next_cursor": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "next_cursor": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "required": [
    "$schema",
    "pages"
  ],
  "additionalProperties": false
}
