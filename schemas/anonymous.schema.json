{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WhisperrAI/whisperr-spec/main/schemas/anonymous.schema.json",
  "title": "Whisperr anonymous-identity conformance cases",
  "type": "object",
  "required": ["version", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "steps", "expectedRequests"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "expectedRequests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/request" }
        }
      }
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "track": {
          "type": "object",
          "required": ["eventType"],
          "additionalProperties": false,
          "properties": {
            "eventType": { "type": "string", "minLength": 1 },
            "properties": { "type": "object" }
          }
        },
        "identify": {
          "type": "object",
          "required": ["externalUserId"],
          "additionalProperties": false,
          "properties": {
            "externalUserId": { "type": "string", "minLength": 1 },
            "traits": { "type": "object" }
          }
        },
        "reset": { "const": true }
      }
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "required": ["endpoint", "events"],
          "additionalProperties": false,
          "properties": {
            "endpoint": { "const": "/v1/events/batch" },
            "events": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/event" }
            }
          }
        },
        {
          "type": "object",
          "required": ["endpoint", "body"],
          "additionalProperties": false,
          "properties": {
            "endpoint": { "const": "/v1/identify" },
            "body": { "$ref": "#/$defs/identify_body" }
          }
        }
      ]
    },
    "event": {
      "description": "An anonymous track event as serialized, minus the volatile occurred_at and context (context must still carry $message_id, as wire.json pins).",
      "type": "object",
      "required": ["anonymous_id", "event_type", "properties"],
      "additionalProperties": false,
      "properties": {
        "anonymous_id": { "$ref": "#/$defs/handle" },
        "event_type": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "properties": { "type": "object" }
      }
    },
    "identify_body": {
      "type": "object",
      "required": ["external_user_id", "anonymous_id"],
      "additionalProperties": false,
      "properties": {
        "external_user_id": { "type": "string", "minLength": 1 },
        "anonymous_id": { "$ref": "#/$defs/handle" },
        "traits": { "type": "object" }
      }
    },
    "handle": {
      "description": "A placeholder, not a literal: the SDK generates the handle, so the harness binds each placeholder to the first value it sees for it and requires every later use to carry the same value. Distinct placeholders must carry distinct values, and every value must be 1-128 characters.",
      "type": "string",
      "pattern": "^\\$anon_[a-z0-9]+$"
    }
  }
}
