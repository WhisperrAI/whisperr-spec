{
  "$schema": "../../schemas/connector-fixture.schema.json",
  "version": 1,
  "provider": "auth0",
  "description": "Auth0 via event/log streams. At-least-once AND out-of-order, so occurrence-time ordering and idempotency are mandatory, not optional.",
  "manifest": {
    "manifest_version": "2.0.0",
    "provider": "auth0",
    "display_name": "Auth0",
    "family": "auth",
    "environments": [
      "production",
      "development"
    ],
    "auth": {
      "mode": "signed_webhook",
      "credential_kinds": [
        "provider_secret"
      ],
      "scopes": [
        {
          "scope": "read:logs",
          "required": true,
          "why": "log stream events"
        },
        {
          "scope": "read:users",
          "required": false,
          "why": "minimized profile fields"
        }
      ],
      "never_requests": [
        "update:users",
        "read:user_idp_tokens"
      ]
    },
    "capabilities": {
      "live_stream": true,
      "history": false,
      "identity": "authoritative",
      "catalog": false,
      "delivery": false
    },
    "correlation": {
      "occurrence_key_template": "auth0:{type}:{log_id}"
    },
    "health": {
      "signals": [
        "stream_lag",
        "signature_valid",
        "out_of_order_rate",
        "error_rate"
      ],
      "degraded_when": [
        "signature_valid == false",
        "stream_lag > 15m"
      ]
    },
    "lifecycle": {
      "disconnect": true,
      "revocation": true,
      "recovery": true,
      "replay": true
    },
    "kill_switch": "provider.auth0",
    "version": "1"
  },
  "cases": [
    {
      "name": "log_stream_event_becomes_envelope",
      "proves": "01: Auth0 stream events map to the canonical envelope",
      "given": {
        "inbound": {
          "type": "ss",
          "log_id": "90020260831091402",
          "user_id": "auth0|991",
          "date": "2026-08-31T09:14:02.117Z",
          "signature_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "mode": "live",
          "subject": {
            "authority": "authoritative",
            "source_subject_id": "auth0|991"
          },
          "origin": {
            "provider": "auth0",
            "source_kind": "stream"
          },
          "time": {
            "occurred_at": "2026-08-31T09:14:02.117Z"
          }
        }
      },
      "demonstrates_capabilities": [
        "live_stream",
        "identity"
      ]
    },
    {
      "name": "out_of_order_delivery_orders_on_occurrence",
      "proves": "01: occurred_at orders, received_at NEVER does",
      "given": {
        "inbound": [
          {
            "type": "su",
            "log_id": "L2",
            "date": "2026-08-31T09:16:00.000Z",
            "user_id": "auth0|991",
            "signature_valid": true
          },
          {
            "type": "ss",
            "log_id": "L1",
            "date": "2026-08-31T09:14:02.117Z",
            "user_id": "auth0|991",
            "signature_valid": true
          }
        ]
      },
      "expect": {
        "outcome": "accepted",
        "notes": "L2 arrives first, L1 second. Final state must reflect L2 as the latest event. Ordering on receipt would corrupt state — this is why occurrence-time ordering is mandatory for EVERY source, not an Auth0 special case."
      }
    },
    {
      "name": "at_least_once_redelivery_is_idempotent",
      "proves": "01: duplicate log_id collapses to one ingest",
      "given": {
        "inbound": {
          "type": "ss",
          "log_id": "L1",
          "user_id": "auth0|991",
          "signature_valid": true,
          "delivery_ordinal": 3
        },
        "state": {
          "already_ingested": [
            "con_auth0:L1"
          ]
        }
      },
      "expect": {
        "outcome": "deduplicated"
      }
    },
    {
      "name": "login_creates_no_consent",
      "proves": "04: consent is never inferred from authentication",
      "negative": true,
      "given": {
        "inbound": {
          "type": "s",
          "log_id": "L3",
          "user_id": "auth0|991",
          "user_name": "ada@example.com",
          "signature_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "consent": []
      }
    },
    {
      "name": "user_blocked_propagates",
      "proves": "03: disablement is handled, not ignored",
      "given": {
        "inbound": {
          "type": "limit_wc",
          "log_id": "L4",
          "user_id": "auth0|991",
          "signature_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "identity": {
          "link_status": "revoked"
        }
      }
    },
    {
      "name": "invalid_signature_rejected",
      "proves": "09: rejection happens before acknowledge",
      "negative": true,
      "given": {
        "inbound": {
          "type": "ss",
          "log_id": "L5",
          "signature_valid": false
        }
      },
      "expect": {
        "outcome": "rejected",
        "rejection_code": "signature_invalid"
      }
    },
    {
      "name": "stale_event_outside_window_rejected",
      "proves": "01: the +5min/-30day acceptance window applies to every source",
      "negative": true,
      "given": {
        "inbound": {
          "type": "ss",
          "log_id": "L6",
          "date": "2026-01-01T00:00:00.000Z",
          "user_id": "auth0|991",
          "signature_valid": true
        }
      },
      "expect": {
        "outcome": "rejected",
        "rejection_code": "timestamp_out_of_window"
      }
    }
  ]
}
