{
  "$schema": "../../schemas/connector-fixture.schema.json",
  "version": 1,
  "provider": "auth0",
  "description": "Auth0 Event Streams CloudEvents over per-stream bearer-authenticated HTTPS. Strict source/tenant/stream binding, authoritative ID-only lifecycle, occurrence ordering and idempotency; not a Management API directory import or login-log connector.",
  "manifest": {
    "manifest_version": "2.0.0",
    "provider": "auth0",
    "display_name": "Auth0",
    "family": "auth",
    "environments": [
      "production",
      "staging",
      "development"
    ],
    "auth": {
      "mode": "webhook_bearer",
      "credential_kinds": [
        "provider_secret"
      ],
      "scopes": [],
      "never_requests": [
        "read:logs",
        "read:users",
        "update:users",
        "read:user_idp_tokens"
      ]
    },
    "capabilities": {
      "live_stream": true,
      "history": false,
      "identity": "authoritative",
      "catalog": false,
      "delivery": false
    },
    "correlation": {
      "occurrence_key_template": "auth0:{type}:{id}"
    },
    "health": {
      "signals": [
        "stream_lag",
        "authentication_valid",
        "out_of_order_rate",
        "error_rate"
      ],
      "degraded_when": [
        "authentication_valid == false",
        "stream_lag > 15m"
      ]
    },
    "lifecycle": {
      "disconnect": true,
      "revocation": true,
      "recovery": true,
      "replay": true
    },
    "kill_switch": "provider.auth0",
    "version": "1"
  },
  "cases": [
    {
      "name": "event_stream_creation_becomes_envelope",
      "proves": "01,03: authenticated user.created CloudEvent establishes authoritative identity after exact source binding",
      "given": {
        "inbound": {
          "specversion": "1.0",
          "type": "user.created",
          "id": "evt_1",
          "source": "urn:auth0:tenant.example.auth0.com",
          "a0tenant": "tenant_fixture",
          "a0stream": "est_fixture",
          "time": "2026-08-31T09:14:02.117Z",
          "data": {
            "object": {
              "user_id": "auth0|991"
            }
          },
          "bearer_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "mode": "live",
          "event": {
            "code": "user_signed_up"
          },
          "subject": {
            "authority": "authoritative",
            "source_subject_id": "auth0|991"
          },
          "origin": {
            "provider": "auth0",
            "source_kind": "stream"
          },
          "time": {
            "occurred_at": "2026-08-31T09:14:02.117Z"
          }
        },
        "consent": []
      },
      "demonstrates_capabilities": [
        "live_stream",
        "identity"
      ]
    },
    {
      "name": "out_of_order_creation_cannot_undo_block",
      "proves": "03: occurrence ordering prevents late creation from reactivating an account",
      "given": {
        "inbound": {
          "sequence": [
            {
              "specversion": "1.0",
              "type": "user.updated",
              "id": "evt_2",
              "source": "urn:auth0:tenant.example.auth0.com",
              "a0tenant": "tenant_fixture",
              "a0stream": "est_fixture",
              "time": "2026-08-31T09:16:00.000Z",
              "data": {
                "object": {
                  "user_id": "auth0|991",
                  "blocked": true
                }
              },
              "bearer_valid": true
            },
            {
              "specversion": "1.0",
              "type": "user.created",
              "id": "evt_1",
              "source": "urn:auth0:tenant.example.auth0.com",
              "a0tenant": "tenant_fixture",
              "a0stream": "est_fixture",
              "time": "2026-08-31T09:14:02.117Z",
              "data": {
                "object": {
                  "user_id": "auth0|991"
                }
              },
              "bearer_valid": true
            }
          ]
        }
      },
      "expect": {
        "outcome": "accepted",
        "identity": {
          "link_status": "revoked"
        },
        "notes": "The newer blocked state wins; receiving an older creation does not reactivate it."
      }
    },
    {
      "name": "at_least_once_redelivery_is_idempotent",
      "proves": "01: duplicate CloudEvent id collapses within its connection",
      "given": {
        "inbound": {
          "specversion": "1.0",
          "type": "user.created",
          "id": "evt_1",
          "source": "urn:auth0:tenant.example.auth0.com",
          "a0tenant": "tenant_fixture",
          "a0stream": "est_fixture",
          "time": "2026-08-31T09:14:02.117Z",
          "data": {
            "object": {
              "user_id": "auth0|991"
            }
          },
          "bearer_valid": true
        },
        "state": {
          "already_ingested": [
            "con_auth0:evt_1"
          ]
        }
      },
      "expect": {
        "outcome": "deduplicated"
      }
    },
    {
      "name": "identity_creates_no_consent_or_profile_copy",
      "proves": "04: authentication lifecycle does not authorize messaging",
      "negative": true,
      "given": {
        "inbound": {
          "specversion": "1.0",
          "type": "user.created",
          "id": "evt_3",
          "source": "urn:auth0:tenant.example.auth0.com",
          "a0tenant": "tenant_fixture",
          "a0stream": "est_fixture",
          "time": "2026-08-31T09:14:02.117Z",
          "data": {
            "object": {
              "user_id": "auth0|991",
              "email": "ada@example.invalid",
              "name": "private"
            }
          },
          "bearer_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "consent": [],
        "notes": "Only user_id and lifecycle status survive projection; no address, name or marketing permission is copied."
      }
    },
    {
      "name": "user_deleted_propagates",
      "proves": "03: authoritative deletion suppresses future personalized dispatch",
      "given": {
        "inbound": {
          "specversion": "1.0",
          "type": "user.deleted",
          "id": "evt_4",
          "source": "urn:auth0:tenant.example.auth0.com",
          "a0tenant": "tenant_fixture",
          "a0stream": "est_fixture",
          "time": "2026-08-31T09:14:02.117Z",
          "data": {
            "object": {
              "user_id": "auth0|991"
            }
          },
          "bearer_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "identity": {
          "link_status": "revoked"
        }
      }
    },
    {
      "name": "invalid_bearer_rejected",
      "proves": "09: failed transport authentication writes no durable state",
      "negative": true,
      "given": {
        "inbound": {
          "specversion": "1.0",
          "type": "user.created",
          "id": "evt_5",
          "source": "urn:auth0:tenant.example.auth0.com",
          "a0tenant": "tenant_fixture",
          "a0stream": "est_fixture",
          "time": "2026-08-31T09:14:02.117Z",
          "data": {
            "object": {
              "user_id": "auth0|991"
            }
          },
          "bearer_valid": false
        }
      },
      "expect": {
        "outcome": "rejected",
        "rejection_code": "signature_invalid",
        "notes": "The shared ingress error family is signature_invalid; Auth0 transport actually verifies a bearer token, not a fictitious signature."
      }
    },
    {
      "name": "wrong_stream_rejected_even_with_valid_bearer",
      "proves": "09: token possession cannot target another source binding",
      "negative": true,
      "given": {
        "inbound": {
          "specversion": "1.0",
          "type": "user.created",
          "id": "evt_6",
          "source": "urn:auth0:tenant.example.auth0.com",
          "a0tenant": "tenant_fixture",
          "a0stream": "est_other",
          "time": "2026-08-31T09:14:02.117Z",
          "data": {
            "object": {
              "user_id": "auth0|991"
            }
          },
          "bearer_valid": true
        }
      },
      "expect": {
        "outcome": "rejected",
        "rejection_code": "signature_invalid"
      }
    },
    {
      "name": "stale_event_outside_window_rejected",
      "proves": "01: canonical timestamp limits apply before persistence",
      "negative": true,
      "given": {
        "inbound": {
          "specversion": "1.0",
          "type": "user.created",
          "id": "evt_7",
          "source": "urn:auth0:tenant.example.auth0.com",
          "a0tenant": "tenant_fixture",
          "a0stream": "est_fixture",
          "time": "2026-01-01T00:00:00.000Z",
          "data": {
            "object": {
              "user_id": "auth0|991"
            }
          },
          "bearer_valid": true
        }
      },
      "expect": {
        "outcome": "rejected",
        "rejection_code": "timestamp_out_of_window"
      }
    }
  ]
}
