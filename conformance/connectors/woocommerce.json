{
  "$schema": "../../schemas/connector-fixture.schema.json",
  "version": 1,
  "provider": "woocommerce",
  "description": "WooCommerce plugin: secure pairing, backend hooks, durable LOCAL retry queue, HPOS compatibility. Checkout must never wait on Whisperr.",
  "manifest": {
    "manifest_version": "2.0.0",
    "provider": "woocommerce",
    "display_name": "WooCommerce",
    "family": "commerce",
    "environments": [
      "production",
      "development"
    ],
    "auth": {
      "mode": "plugin_pairing",
      "credential_kinds": [
        "provider_secret"
      ],
      "scopes": [
        {
          "scope": "pairing_token",
          "required": true,
          "why": "binds one store to one workspace"
        }
      ],
      "never_requests": [
        "wp_admin_credentials",
        "db_credentials"
      ]
    },
    "capabilities": {
      "live_stream": true,
      "history": true,
      "identity": "namespace_authoritative",
      "catalog": true,
      "delivery": false
    },
    "correlation": {
      "occurrence_key_template": "woocommerce:{site_id}:{hook}:{object_id}:{local_seq}"
    },
    "events": [
      {
        "signal": "woocommerce_payment_complete",
        "code": "order_paid",
        "properties": [
          "order_id",
          "amount_minor",
          "currency",
          "item_count",
          "product_ids",
          "coupon_used",
          "payment_method",
          "customer_type"
        ],
        "notes": "amount is a decimal string or amount_minor on the wire; parsed exactly. customer_type is derived from the subject (registered or guest), never read."
      },
      {
        "signal": "woocommerce_order_status_cancelled",
        "code": "order_cancelled",
        "properties": [
          "order_id"
        ]
      },
      {
        "signal": "woocommerce_order_refunded",
        "code": "order_refunded",
        "properties": [
          "order_id",
          "refund_id",
          "refund_amount_minor",
          "currency",
          "full_refund"
        ],
        "notes": "object_id is the refund. refund_amount_minor is Shopify's name on the shared order_refunded code."
      },
      {
        "signal": "woocommerce_order_status_completed",
        "code": "order_fulfilled",
        "properties": [
          "order_id"
        ]
      },
      {
        "signal": "woocommerce_new_customer",
        "code": "customer_created",
        "properties": [],
        "notes": "No name, email or address."
      },
      {
        "signal": "woocommerce_customer_save",
        "code": "customer_updated",
        "properties": []
      },
      {
        "signal": "whisperr/cart_updated",
        "code": "cart_updated",
        "properties": [
          "cart_id",
          "item_count",
          "value_minor",
          "currency",
          "product_ids"
        ],
        "notes": "cart_id is 32 hex characters; value is a decimal string or value_minor on the wire."
      },
      {
        "signal": "whisperr/checkout_started",
        "code": "checkout_started",
        "properties": [
          "cart_id",
          "item_count",
          "value_minor",
          "currency",
          "product_ids"
        ]
      },
      {
        "signal": "whisperr/history_order",
        "code": "order_paid",
        "properties": [
          "order_id",
          "amount_minor",
          "currency",
          "item_count",
          "product_ids",
          "coupon_used",
          "payment_method",
          "customer_type",
          "status"
        ],
        "historical": true,
        "notes": "History batches only (up to 730 days). Follows order_paid's selection; never live coverage."
      }
    ],
    "freshness": {
      "catalog_threshold_seconds": 3600
    },
    "health": {
      "signals": [
        "plugin_heartbeat",
        "local_queue_depth",
        "catalog_freshness",
        "hpos_mode"
      ],
      "degraded_when": [
        "plugin_heartbeat > 30m",
        "local_queue_depth > 10000"
      ]
    },
    "lifecycle": {
      "disconnect": true,
      "revocation": true,
      "recovery": true,
      "replay": true,
      "uninstall_signal": "whisperr/deactivated"
    },
    "kill_switch": "provider.woocommerce",
    "version": "1"
  },
  "cases": [
    {
      "name": "checkout_never_waits_on_whisperr",
      "proves": "§6: a customer's checkout is never coupled to Whisperr availability",
      "given": {
        "inbound": {
          "hook": "woocommerce_payment_complete",
          "object_id": 4471,
          "local_seq": "991",
          "whisperr_reachable": false,
          "site_id": "6f1c2a9e-0b7d-4c55-9a51-2d0f6c3e8b14"
        }
      },
      "expect": {
        "outcome": "accepted",
        "notes": "TIMED TEST. With Whisperr fully unreachable, checkout completes at normal speed. Every call is async/deferred; the event lands in the plugin's local queue.",
        "envelope": {
          "mode": "live",
          "event": {
            "code": "order_paid"
          },
          "origin": {
            "provider": "woocommerce",
            "source_kind": "webhook",
            "provider_event_id": "woocommerce_payment_complete:4471:991"
          },
          "time": {
            "source_sequence": "991"
          },
          "correlation": {
            "idempotency_key": "con_woo:woocommerce_payment_complete:4471:991",
            "occurrence_key": "woocommerce:6f1c2a9e-0b7d-4c55-9a51-2d0f6c3e8b14:woocommerce_payment_complete:4471:991"
          }
        }
      },
      "demonstrates_capabilities": [
        "live_stream"
      ]
    },
    {
      "name": "local_queue_replays_exactly_once_on_recovery",
      "proves": "09: queued events survive an outage and deliver exactly once",
      "given": {
        "inbound": {
          "local_queue": [
            {
              "hook": "woocommerce_payment_complete",
              "object_id": 4471,
              "local_seq": "991"
            }
          ],
          "whisperr_reachable": true,
          "delivery_ordinal": 2
        },
        "state": {
          "already_ingested": [
            "con_woo:woocommerce_payment_complete:4471:991"
          ]
        }
      },
      "expect": {
        "outcome": "deduplicated"
      }
    },
    {
      "name": "hpos_enabled_and_disabled_both_work",
      "proves": "§5(S35): HPOS compatibility is a supported matrix, not an assumption",
      "given": {
        "inbound": {
          "hook": "woocommerce_payment_complete",
          "object_id": 4471,
          "local_seq": "992",
          "hpos": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "notes": "The same case runs with hpos:false and must produce an identical envelope."
      }
    },
    {
      "name": "pairing_cannot_be_replayed_to_another_workspace",
      "proves": "02: pairing is single-use and workspace-bound",
      "negative": true,
      "given": {
        "inbound": {
          "pairing_token": "pt_7Kd",
          "target_workspace": "app_OTHER"
        },
        "state": {
          "token_already_used_by": "app_3Qd"
        }
      },
      "expect": {
        "outcome": "rejected",
        "rejection_code": "signature_invalid"
      }
    },
    {
      "name": "purchase_creates_no_consent",
      "proves": "04: consent is never inferred from a purchase",
      "negative": true,
      "given": {
        "inbound": {
          "hook": "woocommerce_payment_complete",
          "object_id": 4471,
          "billing_email": "ada@example.com",
          "local_seq": "993"
        }
      },
      "expect": {
        "outcome": "accepted",
        "consent": []
      }
    },
    {
      "name": "catalog_projection_is_minimized",
      "proves": "06: minimized offerable projection from the product hook",
      "given": {
        "inbound": {
          "hook": "woocommerce_update_product",
          "object_id": 8471,
          "name": "Trail Runner GTX",
          "price": "129.00",
          "currency": "EUR",
          "stock_status": "instock",
          "description": "long copy…",
          "local_seq": "994"
        }
      },
      "expect": {
        "outcome": "accepted",
        "catalog": {
          "type": "product",
          "name": "Trail Runner GTX",
          "availability": "available",
          "price": {
            "amount_minor": 12900,
            "currency": "EUR"
          }
        }
      },
      "demonstrates_capabilities": [
        "catalog"
      ]
    },
    {
      "name": "deactivation_cleans_up",
      "proves": "02: uninstall leaves no residual data or scheduled tasks",
      "given": {
        "inbound": {
          "hook": "whisperr/deactivated"
        }
      },
      "expect": {
        "outcome": "accepted",
        "coverage": {
          "capability": "live_stream",
          "state": "available"
        },
        "notes": "No orphaned cron entries, no residual options rows, no stranded local queue."
      }
    },
    {
      "name": "history_import_never_live",
      "proves": "08: historical order import is not live coverage",
      "negative": true,
      "given": {
        "inbound": {
          "import": "orders",
          "historical": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "coverage": {
          "capability": "history",
          "state": "validated",
          "label": "historical"
        }
      },
      "demonstrates_capabilities": [
        "history"
      ]
    },
    {
      "name": "namespace_authority_never_overrides_authoritative",
      "proves": "03: WooCommerce is authoritative inside its own customer namespace and nowhere else",
      "demonstrates_capabilities": [
        "identity"
      ],
      "negative": true,
      "given": {
        "inbound": {
          "hook": "woocommerce_customer_save",
          "object_id": 8842001,
          "billing_email": "ada@example.com",
          "local_seq": "995"
        },
        "state": {
          "existing_link": {
            "provider": "clerk",
            "authority": "authoritative",
            "customer_stable_id": "user_8842",
            "source_subject_id": "user_2abc"
          }
        }
      },
      "expect": {
        "outcome": "accepted",
        "identity": {
          "creates_user": false,
          "overrides_authoritative": false,
          "namespace_link_created": true
        },
        "consent": [],
        "notes": "A Woo customer id is a Woo customer id. It never becomes a claim about the Clerk user, and the billing email creates no consent."
      }
    },
    {
      "name": "occurrence_key_is_scoped_to_the_site",
      "proves": "01: a delivery ID is unique only within one site's outbox, so the occurrence names the site",
      "negative": true,
      "given": {
        "inbound": {
          "site_id": "0c5e7d21-9a43-4f86-b2e1-7d3a9c4f5e60",
          "hook": "woocommerce_payment_complete",
          "object_id": 4471,
          "local_seq": "991"
        },
        "state": {
          "already_ingested_occurrences": [
            "woocommerce:6f1c2a9e-0b7d-4c55-9a51-2d0f6c3e8b14:woocommerce_payment_complete:4471:991"
          ]
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "event": {
            "code": "order_paid"
          },
          "correlation": {
            "occurrence_key": "woocommerce:0c5e7d21-9a43-4f86-b2e1-7d3a9c4f5e60:woocommerce_payment_complete:4471:991"
          }
        },
        "notes": "A second store in the workspace, or the same store re-paired after a reinstall (its outbox restarts), sends the same delivery ID. It is a different order and must not correlate with the first."
      },
      "demonstrates_capabilities": [
        "live_stream"
      ]
    },
    {
      "name": "cart_updated_carries_only_the_cart_projection",
      "proves": "01: the plugin's cart hook projects to the allowlisted cart facts",
      "given": {
        "inbound": {
          "site_id": "6f1c2a9e-0b7d-4c55-9a51-2d0f6c3e8b14",
          "hook": "whisperr/cart_updated",
          "object_id": 77,
          "local_seq": "996",
          "data": {
            "cart_id": "9f2c4e1a7b3d5f60a8c2e4b6d8f0a1c3",
            "item_count": 3,
            "value": "187.00",
            "currency": "EUR",
            "product_ids": [
              "8471",
              "9002"
            ]
          },
          "contact": {
            "email": "ada@example.com"
          }
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "event": {
            "code": "cart_updated",
            "properties": {
              "cart_id": "9f2c4e1a7b3d5f60a8c2e4b6d8f0a1c3",
              "item_count": 3,
              "value_minor": 18700,
              "currency": "EUR",
              "product_ids": [
                "8471",
                "9002"
              ]
            }
          },
          "correlation": {
            "occurrence_key": "woocommerce:6f1c2a9e-0b7d-4c55-9a51-2d0f6c3e8b14:whisperr/cart_updated:77:996"
          }
        },
        "consent": [],
        "notes": "The contact email never becomes a property or a consent; with contact_sync it is stored as a pending address only."
      },
      "demonstrates_capabilities": [
        "live_stream"
      ]
    },
    {
      "name": "refund_uses_the_shared_commerce_property_names",
      "proves": "05: order_refunded is shared with Shopify, so WooCommerce projects the same property names",
      "given": {
        "inbound": {
          "site_id": "6f1c2a9e-0b7d-4c55-9a51-2d0f6c3e8b14",
          "hook": "woocommerce_order_refunded",
          "object_id": 5120,
          "local_seq": "997",
          "data": {
            "order_id": "4471",
            "refund_id": "5120",
            "amount": "29.00",
            "currency": "EUR",
            "full_refund": false
          }
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "event": {
            "code": "order_refunded",
            "properties": {
              "order_id": "4471",
              "refund_id": "5120",
              "refund_amount_minor": 2900,
              "currency": "EUR",
              "full_refund": false
            }
          },
          "correlation": {
            "occurrence_key": "woocommerce:6f1c2a9e-0b7d-4c55-9a51-2d0f6c3e8b14:woocommerce_order_refunded:5120:997"
          }
        },
        "notes": "A workspace with both stores approves one order_refunded definition whose schema is the union of the two; a store adds properties, it never changes a shared one."
      }
    }
  ]
}
