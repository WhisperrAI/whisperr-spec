{
  "$schema": "../../schemas/connector-fixture.schema.json",
  "version": 1,
  "provider": "stripe",
  "description": "Stripe connected as a Stripe App via OAuth — never a pasted secret key. resolve_only identity: it can never create a user.",
  "manifest": {
    "manifest_version": "2.0.0",
    "provider": "stripe",
    "display_name": "Stripe",
    "family": "billing",
    "environments": [
      "production",
      "development",
      "staging"
    ],
    "auth": {
      "mode": "oauth",
      "credential_kinds": [
        "oauth_token",
        "provider_secret"
      ],
      "scopes": [
        {
          "scope": "event_read",
          "required": true,
          "why": "Receive billing lifecycle events to identify relevant retention opportunities in Whisperr."
        },
        {
          "scope": "customer_read",
          "required": true,
          "why": "Match Stripe customer identifiers and approved metadata to users in your Whisperr workspace."
        },
        {
          "scope": "invoice_read",
          "required": true,
          "why": "Read invoice payment status to identify failed payments and payment recovery."
        },
        {
          "scope": "subscription_read",
          "required": true,
          "why": "Read subscription status and lifecycle changes for retention workflows."
        },
        {
          "scope": "charge_read",
          "required": true,
          "why": "Read charge and refund status to keep billing outcomes accurate and avoid inappropriate follow-ups."
        }
      ],
      "never_requests": [
        "any *_write permission",
        "payment management",
        "customer_write",
        "secret_key_paste"
      ],
      "oauth": {
        "redirect_uri": "https://api.whisperr.net/v1/connections/stripe/oauth/callback",
        "app_identifier": "net.whisperr",
        "token_exchange": "developer_api_key",
        "registration_status": "registered_unpublished",
        "clients": [
          {
            "install_mode": "live",
            "client_id": "ca_VAmSTNuKJc08cFYdPf4EzvMZvmZo57dz",
            "environment": "production"
          },
          {
            "install_mode": "test",
            "client_id": "ca_VAmSjMzvaOq98lw56Je1dXMkWyclBLRV",
            "environment": "development"
          },
          {
            "install_mode": "sandbox",
            "client_id": "ca_VAmSpR97eu8O1mUXZDKVvKYssIsSTeKa",
            "environment": "staging"
          }
        ],
        "authorize_url_template": "https://marketplace.stripe.com/oauth/v2/chnlink_61VJpnv3ALrwIkJas412MZnPq8FGX3zs/authorize?client_id={client_id}&redirect_uri={redirect_uri}",
        "redirect_uri_operational": false
      },
      "granted_scopes": [
        "event_read",
        "customer_read",
        "invoice_read",
        "subscription_read",
        "charge_read"
      ]
    },
    "capabilities": {
      "live_stream": true,
      "history": true,
      "identity": "resolve_only",
      "catalog": false,
      "delivery": false
    },
    "correlation": {
      "occurrence_key_template": "stripe:{object}:{object_id}:{type}:{provider_event_id}"
    },
    "health": {
      "signals": [
        "webhook_receipt_lag",
        "auth_valid",
        "error_rate"
      ],
      "degraded_when": [
        "auth_valid == false",
        "webhook_receipt_lag > 15m"
      ]
    },
    "lifecycle": {
      "disconnect": true,
      "revocation": true,
      "recovery": true,
      "replay": true
    },
    "kill_switch": "provider.stripe",
    "version": "1"
  },
  "cases": [
    {
      "name": "payment_failed_resolves_existing_user",
      "proves": "03: a resolve_only source attaches to an EXISTING link",
      "given": {
        "inbound": {
          "type": "invoice.payment_failed",
          "id": "evt_1P9xKl2eZvKYlo2C",
          "data": {
            "object": {
              "id": "in_1P9x",
              "customer": "cus_Nffr",
              "amount_due": 4900,
              "currency": "eur"
            }
          },
          "created": "2026-08-31T09:14:02.117Z",
          "signature_valid": true
        },
        "state": {
          "existing_link": {
            "provider": "stripe",
            "source_subject_id": "cus_Nffr",
            "customer_stable_id": "user_8842"
          }
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "mode": "live",
          "event": {
            "code": "payment_failed",
            "properties": {
              "amount_minor": 4900,
              "currency": "EUR"
            }
          },
          "subject": {
            "authority": "resolve_only",
            "source_subject_id": "cus_Nffr",
            "customer_stable_id": "user_8842",
            "resolution": "resolved"
          },
          "origin": {
            "provider": "stripe",
            "source_kind": "webhook",
            "provider_event_id": "evt_1P9xKl2eZvKYlo2C"
          },
          "correlation": {
            "occurrence_key": "stripe:invoice:in_1P9x:invoice.payment_failed:evt_1P9xKl2eZvKYlo2C"
          }
        },
        "identity": {
          "creates_user": false
        }
      },
      "demonstrates_capabilities": [
        "live_stream",
        "identity"
      ],
      "requires_scopes": [
        "event_read",
        "invoice_read",
        "customer_read"
      ]
    },
    {
      "name": "unknown_customer_never_creates_a_user",
      "proves": "03: resolve_only can NEVER create a user — the highest-value negative in the program",
      "negative": true,
      "given": {
        "inbound": {
          "type": "invoice.payment_failed",
          "id": "evt_1P9y",
          "data": {
            "object": {
              "customer": "cus_UNKNOWN"
            }
          },
          "signature_valid": true
        },
        "state": {
          "existing_link": null
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "subject": {
            "resolution": "unresolved",
            "customer_stable_id": null
          }
        },
        "identity": {
          "creates_user": false
        },
        "notes": "The event is retained with no user. A shadow user here would later collide with the real one — this is the corruption this mode exists to prevent."
      },
      "requires_scopes": [
        "event_read",
        "customer_read"
      ]
    },
    {
      "name": "event_outside_the_matrix_is_ignored",
      "proves": "02: an exact event matrix, never 'all Stripe events'",
      "negative": true,
      "given": {
        "inbound": {
          "type": "radar.early_fraud_warning.created",
          "id": "evt_1P9z",
          "signature_valid": true
        },
        "state": {
          "event_matrix": [
            "invoice.payment_failed",
            "invoice.payment_succeeded",
            "customer.subscription.deleted",
            "customer.subscription.updated",
            "charge.refunded"
          ]
        }
      },
      "expect": {
        "outcome": "ignored",
        "notes": "Ignored, not errored. This is the matrix declared at registration; the connector's handlers and the Stripe-side subscriptions must stay equal to it in both directions. Subscribing to everything is how a connector becomes unauditable."
      }
    },
    {
      "name": "duplicate_event_id_is_idempotent",
      "proves": "01: idempotency is per (connection, provider_event_id)",
      "given": {
        "inbound": {
          "type": "invoice.payment_failed",
          "id": "evt_1P9xKl2eZvKYlo2C",
          "signature_valid": true,
          "delivery_ordinal": 2
        },
        "state": {
          "already_ingested": [
            "con_stripe:evt_1P9xKl2eZvKYlo2C"
          ]
        }
      },
      "expect": {
        "outcome": "deduplicated"
      }
    },
    {
      "name": "repeatable_object_updates_are_distinct_occurrences",
      "proves": "01: the same subscription can update repeatedly; object ID plus type must not collapse distinct provider events",
      "given": {
        "inbound": {
          "type": "customer.subscription.updated",
          "id": "evt_second_update",
          "data": { "object": { "id": "sub_repeat", "customer": "cus_existing", "status": "active" } },
          "signature_valid": true
        },
        "state": {
          "already_ingested": ["con_stripe:evt_first_update"],
          "existing_occurrence": "stripe:subscription:sub_repeat:customer.subscription.updated:evt_first_update"
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": { "correlation": { "occurrence_key": "stripe:subscription:sub_repeat:customer.subscription.updated:evt_second_update" } },
        "notes": "Retries of evt_second_update deduplicate, but the distinct first update remains a separate occurrence. A second authorized connection receiving this same event correlates using the same occurrence key."
      }
    },
    {
      "name": "payment_creates_no_consent",
      "proves": "04: consent is never inferred from a payment",
      "negative": true,
      "given": {
        "inbound": {
          "type": "invoice.payment_succeeded",
          "id": "evt_1PA0",
          "data": {
            "object": {
              "customer": "cus_Nffr",
              "customer_email": "ada@example.com"
            }
          },
          "signature_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "consent": [],
        "notes": "customer_email is present in the payload and produces NO assertion. It is not even stored unless Whisperr performs delivery."
      },
      "requires_scopes": [
        "event_read",
        "customer_read"
      ]
    },
    {
      "name": "invalid_signature_rejected",
      "proves": "09: rejection precedes any durable write",
      "negative": true,
      "given": {
        "inbound": {
          "type": "invoice.payment_failed",
          "id": "evt_1PA1",
          "signature_valid": false
        }
      },
      "expect": {
        "outcome": "rejected",
        "rejection_code": "signature_invalid"
      }
    },
    {
      "name": "payload_minimized_before_storage",
      "proves": "01+F13: only the allowlisted projection is durably stored",
      "negative": true,
      "given": {
        "inbound": {
          "type": "invoice.payment_failed",
          "id": "evt_1PA2",
          "data": {
            "object": {
              "customer": "cus_Nffr",
              "amount_due": 4900,
              "currency": "eur",
              "customer_address": {
                "line1": "12 Rue de Rivoli",
                "city": "Paris"
              },
              "payment_method_details": {
                "card": {
                  "last4": "4242"
                }
              }
            }
          },
          "signature_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "event": {
            "properties": {
              "amount_minor": 4900,
              "currency": "EUR"
            }
          }
        },
        "notes": "customer_address and card details are dropped BEFORE the durable write, not filtered on read."
      }
    },
    {
      "name": "oauth_revocation_degrades_this_provider_only",
      "proves": "02+08: one provider's failure never affects another",
      "negative": true,
      "given": {
        "inbound": {
          "oauth_revoked": true
        },
        "state": {
          "other_connections": [
            "con_clerk",
            "con_shopify"
          ]
        }
      },
      "expect": {
        "outcome": "accepted",
        "coverage": {
          "capability": "live_stream",
          "state": "wired",
          "label": "needs_attention",
          "smallest_repair_action": "Reconnect Stripe — authorization was revoked."
        },
        "notes": "con_clerk and con_shopify are asserted UNAFFECTED. Isolation is a test, not an aspiration."
      }
    },
    {
      "name": "historical_import_never_live",
      "proves": "08: history never displays as live coverage",
      "negative": true,
      "given": {
        "inbound": {
          "import": "invoices",
          "range": "2025-01-01..2026-08-01",
          "historical": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "coverage": {
          "capability": "history",
          "state": "validated",
          "label": "historical"
        }
      },
      "demonstrates_capabilities": [
        "history"
      ],
      "requires_scopes": [
        "invoice_read"
      ]
    },
    {
      "name": "customer_stripe_is_not_whisperrs_own_billing",
      "proves": "02: the customer's Stripe connection and Whisperr's own subscription billing are different systems that must never share a handler",
      "negative": true,
      "requires_scopes": [
        "event_read"
      ],
      "given": {
        "inbound": {
          "type": "invoice.payment_failed",
          "id": "evt_1PB0",
          "signature_valid": true,
          "arrived_on": "whisperr_own_billing_webhook_endpoint"
        }
      },
      "expect": {
        "outcome": "rejected",
        "rejection_code": "signature_invalid",
        "notes": "Whisperr's own billing webhook (internal/billing/webhook.go) processes Whisperr charging ITS customers. This connector processes a customer's Stripe account observing THEIR revenue. Reuse the claim-lease and payload-minimization PATTERN; never route one through the other's endpoint or signing secret. Distinct connection_id, distinct signing secret, distinct tenant."
      }
    },
    {
      "name": "stripe_test_mode_is_environment_not_envelope_mode",
      "proves": "01: Stripe's test/live mode is the connection's environment; envelope mode is Whisperr's test-event lane. Two different axes.",
      "negative": true,
      "requires_scopes": [
        "event_read"
      ],
      "given": {
        "inbound": {
          "type": "invoice.payment_failed",
          "id": "evt_test_1",
          "livemode": false,
          "signature_valid": true
        },
        "state": {
          "connection_environment": "development"
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "mode": "live",
          "origin": {
            "provider": "stripe"
          }
        },
        "notes": "A real event from a Stripe TEST-mode connection is envelope mode:live — it is a genuine observation of that connection. envelope mode:test is reserved for Whisperr's own isolated validation lane. Collapsing these would either leak sandbox data into production coverage or make real events unprocessable."
      }
    },
    {
      "name": "install_mode_selects_its_own_client_id",
      "proves": "02: Stripe issues a separate OAuth client_id per install mode; the connection's environment selects it",
      "negative": true,
      "requires_scopes": [
        "event_read"
      ],
      "given": {
        "inbound": {
          "authorize_request": true,
          "connection_environment": "development"
        },
        "state": {
          "available_clients": {
            "live": "ca_VAmSTNuKJc08cFYdPf4EzvMZvmZo57dz",
            "test": "ca_VAmSjMzvaOq98lw56Je1dXMkWyclBLRV",
            "sandbox": "ca_VAmSpR97eu8O1mUXZDKVvKYssIsSTeKa"
          }
        }
      },
      "expect": {
        "outcome": "accepted",
        "notes": "A development-environment connection MUST build its authorize URL with the `test` client_id. Using the live client_id for a test connection fails the install with an error that does not name the real cause. The manifest's clients[] is the lookup — the connector never hardcodes one. This is the concrete consequence of keeping the connection's environment separate from the envelope's mode (contract 01): the environment axis SELECTS THE CREDENTIAL."
      }
    }
  ]
}
