{
  "$schema": "../../schemas/connector-fixture.schema.json",
  "version": 1,
  "provider": "shopify",
  "description": "Shopify app: scoped offline access, standard + compliance webhooks, checkout and fulfillment signals, storefront pixel, catalog sync with repair, owner-approved contact email import. Authoritative ONLY within its own customer namespace.",
  "manifest": {
    "manifest_version": "2.0.0",
    "provider": "shopify",
    "display_name": "Shopify",
    "family": "commerce",
    "environments": [
      "production",
      "development"
    ],
    "auth": {
      "mode": "oauth",
      "credential_kinds": [
        "oauth_token",
        "provider_secret"
      ],
      "scopes": [
        {
          "scope": "read_orders",
          "required": true,
          "why": "order, refund and checkout events, and the exact order read back for refunds and fulfillments"
        },
        {
          "scope": "read_products",
          "required": true,
          "why": "catalog projection"
        },
        {
          "scope": "read_inventory",
          "required": true,
          "why": "availability — an out-of-stock item must never be offered"
        },
        {
          "scope": "read_customers",
          "required": true,
          "why": "customer webhooks and namespace identity links (Shopify refuses customers/* subscriptions without it), the exact order's customer for refunds and fulfillments, and the owner-approved contact email import"
        },
        {
          "scope": "read_fulfillments",
          "required": true,
          "why": "order_shipped and order_delivered (fulfillments/create and fulfillments/update)"
        },
        {
          "scope": "write_pixels",
          "required": false,
          "why": "install the storefront pixel extension"
        },
        {
          "scope": "read_customer_events",
          "required": false,
          "why": "receive storefront pixel events"
        }
      ],
      "never_requests": [
        "write_products",
        "write_orders",
        "write_customers"
      ],
      "oauth": {
        "redirect_uri": "https://api.whisperr.net/v1/connections/shopify/oauth/callback",
        "app_identifier": "417240809473",
        "token_exchange": "client_secret",
        "registration_status": "registered_unpublished",
        "clients": [
          {
            "install_mode": "default",
            "client_id": "9182e42a56d4cca402f5e3335ba88cd3",
            "environment": null
          }
        ],
        "authorize_url_template": null,
        "redirect_uri_operational": false
      },
      "granted_scopes": [
        "read_orders",
        "read_products",
        "read_inventory",
        "read_customers"
      ],
      "scope_deltas": {
        "pending_grant": [
          {
            "scope": "read_fulfillments",
            "closed_by": "whisperr-go#629",
            "note": "App version whisperr-3 registers read_orders, read_products, read_inventory and read_customers. #629's shopify.app.toml adds read_fulfillments and the orders/create, checkouts/* and fulfillments/* topics; deploy it as app version whisperr-4 before the runtime default requests the scope, or authorization fails closed."
          },
          {
            "scope": "write_pixels",
            "closed_by": "S34",
            "note": "Optional, for the storefront pixel extension. extension_directories is still empty; grant it when the pixel is implemented."
          },
          {
            "scope": "read_customer_events",
            "closed_by": "S34",
            "note": "Optional, pairs with write_pixels to receive storefront pixel events."
          }
        ]
      }
    },
    "capabilities": {
      "live_stream": true,
      "history": false,
      "identity": "namespace_authoritative",
      "catalog": true,
      "delivery": false
    },
    "correlation": {
      "occurrence_key_template": "shopify:{topic}:{provider_event_id}"
    },
    "events": [
      {
        "signal": "orders/paid",
        "code": "order_paid",
        "properties": [
          "order_id",
          "amount_minor",
          "currency",
          "checkout_id",
          "product_ids",
          "catalog_item_id",
          "catalog_item_kind",
          "item_count",
          "line_count",
          "discount_used",
          "discount_amount_minor",
          "sales_channel",
          "customer_order_count"
        ],
        "counts_as_activity": true,
        "requires_scopes": [
          "read_orders"
        ],
        "notes": "catalog_item_* names the highest-value line. sales_channel is online_store, pos, draft_order or app. customer_order_count is a best-effort read of the order's customer when the order is processed (read_orders and read_customers), omitted when it fails. Discount code text is never kept."
      },
      {
        "signal": "orders/create",
        "code": "order_placed",
        "properties": [
          "order_id",
          "amount_minor",
          "currency",
          "checkout_id",
          "product_ids",
          "catalog_item_id",
          "catalog_item_kind",
          "item_count",
          "line_count",
          "discount_used",
          "discount_amount_minor",
          "sales_channel"
        ],
        "suggested": false,
        "counts_as_activity": true,
        "requires_scopes": [
          "read_orders"
        ],
        "notes": "For offline payment gateways. Offered, never suggested: for most stores it duplicates order_paid."
      },
      {
        "signal": "orders/cancelled",
        "code": "order_cancelled",
        "properties": [
          "order_id"
        ],
        "requires_scopes": [
          "read_orders"
        ]
      },
      {
        "signal": "orders/fulfilled",
        "code": "order_fulfilled",
        "properties": [
          "order_id"
        ],
        "requires_scopes": [
          "read_orders"
        ]
      },
      {
        "signal": "refunds/create",
        "code": "order_refunded",
        "properties": [
          "order_id",
          "refund_amount_minor",
          "currency",
          "refunded_product_ids"
        ],
        "requires_scopes": [
          "read_orders",
          "read_customers"
        ],
        "notes": "Sums successful refund transactions only; mixed currencies report no amount. The subject is the exact order's customer, read back from Shopify."
      },
      {
        "signal": "checkouts/started",
        "topics": [
          "checkouts/create",
          "checkouts/update"
        ],
        "code": "checkout_started",
        "properties": [
          "checkout_id"
        ],
        "occurrence_key_template": "shopify:checkout_started:{checkout_id}",
        "counts_as_activity": true,
        "requires_scopes": [
          "read_orders"
        ],
        "notes": "Once per checkout: the first delivery that names a customer wins. A checkout without a customer is ignored until one does."
      },
      {
        "signal": "checkouts/updated",
        "topics": [
          "checkouts/create",
          "checkouts/update"
        ],
        "code": "checkout_updated",
        "properties": [
          "checkout_id",
          "product_ids",
          "catalog_item_id",
          "catalog_item_kind",
          "item_count",
          "value_minor",
          "currency"
        ],
        "occurrence_key_template": "shopify:checkout_updated:{checkout_id}:{contents_digest}",
        "counts_as_activity": true,
        "requires_scopes": [
          "read_orders"
        ],
        "notes": "contents_digest = the first 16 hex characters of SHA-256 over the sorted product_id/variant_id/quantity lines joined by commas, then |total_price|currency. The same contents deduplicate; changed contents are a new occurrence. abandoned_checkout_url is a bearer link and is never stored."
      },
      {
        "signal": "checkouts/completed",
        "topics": [
          "checkouts/update"
        ],
        "code": "checkout_completed",
        "properties": [
          "checkout_id"
        ],
        "occurrence_key_template": "shopify:checkout_completed:{checkout_id}",
        "requires_scopes": [
          "read_orders"
        ],
        "notes": "Only when completed_at is set. Abandonment matches checkout_started to a finish event's checkout_id."
      },
      {
        "signal": "fulfillments/shipped",
        "topics": [
          "fulfillments/create",
          "fulfillments/update"
        ],
        "code": "order_shipped",
        "properties": [
          "order_id",
          "fulfillment_id",
          "product_ids",
          "item_count"
        ],
        "occurrence_key_template": "shopify:order_shipped:{fulfillment_id}",
        "requires_scopes": [
          "read_fulfillments",
          "read_orders",
          "read_customers"
        ],
        "notes": "Status success. An update for a fulfillment created more than 29 days ago is not a new shipment. Carrier, tracking numbers, estimated dates and destination are never kept."
      },
      {
        "signal": "fulfillments/delivered",
        "topics": [
          "fulfillments/update"
        ],
        "code": "order_delivered",
        "properties": [
          "order_id",
          "fulfillment_id",
          "product_ids",
          "item_count"
        ],
        "occurrence_key_template": "shopify:order_delivered:{fulfillment_id}",
        "requires_scopes": [
          "read_fulfillments",
          "read_orders",
          "read_customers"
        ],
        "notes": "shipment_status delivered, once per fulfillment."
      },
      {
        "signal": "customers/create",
        "code": "customer_created",
        "properties": [],
        "requires_scopes": [
          "read_customers"
        ],
        "notes": "Consent and the contact import run in the control queue, never as properties."
      },
      {
        "signal": "customers/update",
        "code": "customer_updated",
        "properties": [],
        "requires_scopes": [
          "read_customers"
        ]
      }
    ],
    "freshness": {
      "catalog_threshold_seconds": 3600
    },
    "health": {
      "signals": [
        "webhook_receipt_lag",
        "auth_valid",
        "catalog_freshness",
        "scope_drift",
        "error_rate"
      ],
      "degraded_when": [
        "auth_valid == false",
        "webhook_receipt_lag > 15m",
        "catalog_freshness > 1h"
      ]
    },
    "lifecycle": {
      "disconnect": true,
      "revocation": true,
      "recovery": true,
      "replay": true,
      "uninstall_signal": "app/uninstalled",
      "scope_change_signal": "app/scopes_update"
    },
    "kill_switch": "provider.shopify",
    "version": "1"
  },
  "cases": [
    {
      "name": "order_paid_becomes_event",
      "proves": "01: standard webhook → canonical envelope",
      "given": {
        "inbound": {
          "topic": "orders/paid",
          "x_shopify_webhook_id": "b1e2",
          "order_id": 4471,
          "customer": {
            "id": 8842001
          },
          "total_price": "129.00",
          "currency": "EUR",
          "created_at": "2026-08-31T09:14:02.117Z",
          "hmac_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "mode": "live",
          "event": {
            "code": "order_paid"
          },
          "subject": {
            "authority": "namespace_authoritative",
            "source_subject_id": "8842001"
          },
          "origin": {
            "provider": "shopify",
            "source_kind": "webhook"
          },
          "correlation": {
            "occurrence_key": "shopify:orders/paid:b1e2"
          }
        }
      },
      "demonstrates_capabilities": [
        "live_stream"
      ],
      "requires_scopes": [
        "read_orders"
      ]
    },
    {
      "name": "namespace_authority_never_overrides_authoritative",
      "proves": "03: namespace_authoritative is authoritative INSIDE its namespace and nowhere else",
      "negative": true,
      "given": {
        "inbound": {
          "topic": "customers/update",
          "x_shopify_webhook_id": "b1e3",
          "customer": {
            "id": 8842001,
            "email": "ada@example.com"
          },
          "hmac_valid": true
        },
        "state": {
          "existing_link": {
            "provider": "clerk",
            "authority": "authoritative",
            "customer_stable_id": "user_8842",
            "source_subject_id": "user_2abc"
          }
        }
      },
      "expect": {
        "outcome": "accepted",
        "identity": {
          "creates_user": false,
          "overrides_authoritative": false,
          "namespace_link_created": true
        },
        "notes": "Shopify may say 'this is Shopify customer 8842001'. It may NOT say 'and that is Clerk user_2abc' without the customer's own stable id in the payload."
      },
      "demonstrates_capabilities": [
        "identity"
      ],
      "requires_scopes": [
        "read_customers"
      ]
    },
    {
      "name": "purchase_creates_no_consent",
      "proves": "04: consent is never inferred from a purchase or checkout",
      "negative": true,
      "given": {
        "inbound": {
          "topic": "orders/paid",
          "x_shopify_webhook_id": "b1e4",
          "customer": {
            "email": "ada@example.com",
            "accepts_marketing": null
          },
          "hmac_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "consent": []
      },
      "requires_scopes": [
        "read_orders"
      ]
    },
    {
      "name": "explicit_marketing_optin_is_an_assertion",
      "proves": "04: an explicit opt-in IS consent with basis explicit_user_action",
      "given": {
        "inbound": {
          "topic": "customers/update",
          "x_shopify_webhook_id": "b1e5",
          "customer": {
            "id": 8842001,
            "email_marketing_consent": {
              "state": "subscribed",
              "consent_updated_at": "2026-08-30T12:00:00.000Z"
            }
          },
          "hmac_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "consent": [
          {
            "channel": "email",
            "status": "opted_in",
            "basis": "explicit_user_action",
            "source": {
              "connection_id": "con_shopify",
              "provider": "shopify"
            },
            "asserted_at": "2026-08-30T12:00:00.000Z"
          }
        ],
        "notes": "The distinction that matters: the shopper acted. Contrast with the purchase case above."
      },
      "requires_scopes": [
        "read_customers"
      ]
    },
    {
      "name": "catalog_projection_is_minimized",
      "proves": "06: only the offerable projection is stored",
      "given": {
        "inbound": {
          "topic": "products/update",
          "x_shopify_webhook_id": "b1e6",
          "product": {
            "id": 8471,
            "title": "Trail Runner GTX",
            "handle": "trail-runner-gtx",
            "status": "active",
            "variants": [
              {
                "price": "129.00",
                "inventory_quantity": 12
              }
            ],
            "body_html": "<p>long marketing copy…</p>",
            "vendor": "ACME",
            "tags": "internal-sku-9912"
          }
        },
        "state": {
          "currency": "EUR"
        }
      },
      "expect": {
        "outcome": "accepted",
        "catalog": {
          "source_item_id": "gid://shopify/Product/8471",
          "type": "product",
          "name": "Trail Runner GTX",
          "availability": "available",
          "price": {
            "amount_minor": 12900,
            "currency": "EUR"
          }
        },
        "notes": "body_html, vendor and tags are NOT stored."
      },
      "demonstrates_capabilities": [
        "catalog"
      ],
      "requires_scopes": [
        "read_products"
      ]
    },
    {
      "name": "out_of_stock_is_never_offered",
      "proves": "06: history ranks, it never proves availability",
      "negative": true,
      "given": {
        "inbound": {
          "topic": "products/update",
          "x_shopify_webhook_id": "b1e7",
          "product": {
            "id": 8471,
            "status": "active",
            "variants": [
              {
                "inventory_quantity": 0
              }
            ]
          }
        },
        "state": {
          "user_purchase_history": [
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471",
            "gid://shopify/Product/8471"
          ]
        }
      },
      "expect": {
        "outcome": "accepted",
        "catalog": {
          "availability": "unavailable",
          "is_candidate": false
        },
        "notes": "Bought monthly for a year. Still not offered, because today it is out of stock."
      },
      "requires_scopes": [
        "read_products",
        "read_inventory"
      ]
    },
    {
      "name": "stale_catalog_becomes_unknown_and_suppresses",
      "proves": "06: past the freshness threshold, availability collapses to unknown",
      "negative": true,
      "given": {
        "inbound": {
          "catalog_last_synced": "2026-08-31T06:00:00.000Z",
          "now": "2026-08-31T09:14:02.117Z"
        }
      },
      "expect": {
        "outcome": "suppressed",
        "catalog": {
          "availability": "unknown",
          "is_candidate": false
        },
        "quarantine": {
          "disposition": "suppressed",
          "code": "catalog_uncertain",
          "replayable": true
        },
        "notes": "The OFFER is suppressed. The message still sends if it can say something useful without naming an item."
      }
    },
    {
      "name": "uninstall_then_reinstall_is_clean",
      "proves": "02: uninstall/reinstall leaves no orphans and no duplicates",
      "given": {
        "inbound": {
          "sequence": [
            {
              "topic": "app/uninstalled",
              "x_shopify_webhook_id": "b1e8",
              "hmac_valid": true
            },
            {
              "topic": "app/installed",
              "x_shopify_webhook_id": "b1e9",
              "hmac_valid": true
            }
          ]
        }
      },
      "expect": {
        "outcome": "accepted",
        "coverage": {
          "capability": "live_stream",
          "state": "wired"
        },
        "notes": "After reinstall: no orphaned catalog rows, no duplicated identity links, no double-counted events."
      }
    },
    {
      "name": "scope_change_surfaces_one_repair_action",
      "proves": "08: degradation names exactly one next step",
      "given": {
        "inbound": {
          "topic": "app/scopes_update",
          "x_shopify_webhook_id": "b1ea",
          "removed": [
            "read_products"
          ],
          "hmac_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "coverage": {
          "capability": "catalog",
          "state": "wired",
          "label": "needs_attention",
          "smallest_repair_action": "Re-authorize Shopify to restore read_products — catalog sync is paused."
        },
        "notes": "live_stream stays healthy. Capability state is per-capability precisely so one lost scope does not black out the connector."
      }
    },
    {
      "name": "invalid_hmac_rejected",
      "proves": "09: rejection precedes persistence",
      "negative": true,
      "given": {
        "inbound": {
          "topic": "orders/paid",
          "x_shopify_webhook_id": "b1eb",
          "hmac_valid": false
        }
      },
      "expect": {
        "outcome": "rejected",
        "rejection_code": "signature_invalid"
      }
    },
    {
      "name": "compliance_webhooks_answered",
      "proves": "§8: mandatory compliance webhooks are implemented",
      "given": {
        "inbound": {
          "topic": "customers/data_request",
          "x_shopify_webhook_id": "b1ec",
          "hmac_valid": true
        }
      },
      "expect": {
        "outcome": "accepted",
        "notes": "customers/data_request, customers/redact and shop/redact all respond correctly. Required for app review (blocker B1)."
      }
    },
    {
      "name": "pixel_event_uses_the_same_envelope",
      "proves": "01: the storefront pixel extension is a source, not a parallel system",
      "given": {
        "inbound": {
          "source_kind": "sdk",
          "pixel_event": "checkout_started",
          "occurred_at": "2026-08-31T09:14:02.117Z",
          "claimed_customer_id": "8842001"
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "origin": {
            "provider": "shopify",
            "source_kind": "sdk"
          },
          "event": {
            "code": "checkout_started"
          },
          "subject": {
            "authority": "anonymous"
          }
        },
        "notes": "Browser pixel claims are untrusted and stay anonymous, even if a customer ID matches a known server-side identity. They do not prove authenticated live order transport or permit personalized dispatch."
      },
      "requires_scopes": [
        "write_pixels",
        "read_customer_events"
      ]
    },
    {
      "name": "historical_order_import_not_advertised",
      "proves": "08: unimplemented history does not appear as an available capability",
      "negative": true,
      "given": {
        "inbound": {
          "import": "orders",
          "range": "2025-01-01..2026-08-01",
          "historical": true
        }
      },
      "expect": {
        "outcome": "rejected",
        "notes": "S34 implements current catalog synchronization and live webhooks, not historical order backfill. History remains false until a tested importer exists; it can never promote live_stream."
      },
      "requires_scopes": [
        "read_orders"
      ]
    },
    {
      "name": "order_paid_carries_minimized_purchase_facts",
      "proves": "01: orders/paid projects only the purchase allowlist",
      "given": {
        "inbound": {
          "topic": "orders/paid",
          "x_shopify_webhook_id": "b1f0",
          "order_id": 4471,
          "customer": {
            "id": 8842001,
            "email": "ada@example.com"
          },
          "checkout_id": 3301,
          "total_price": "187.00",
          "total_discounts": "10.00",
          "currency": "EUR",
          "source_name": "web",
          "discount_codes": [
            {
              "code": "ADA10"
            }
          ],
          "line_items": [
            {
              "product_id": 8471,
              "variant_id": 41001,
              "quantity": 1,
              "price": "129.00"
            },
            {
              "product_id": 9002,
              "variant_id": 52002,
              "quantity": 2,
              "price": "29.00"
            },
            {
              "product_id": null,
              "quantity": 1,
              "price": "0.00",
              "title": "Gift wrap"
            }
          ],
          "shipping_address": {
            "address1": "1 Example St"
          },
          "created_at": "2026-08-31T09:14:02.117Z",
          "hmac_valid": true
        },
        "state": {
          "customer_order_count": 3
        }
      },
      "expect": {
        "outcome": "accepted",
        "envelope": {
          "event": {
            "code": "order_paid",
            "properties": {
              "order_id": "gid://shopify/Order/4471",
              "amount_minor": 18700,
              "currency": "EUR",
              "checkout_id": "3301",
              "product_ids": [
                "gid://shopify/Product/8471",
                "gid://shopify/Product/9002"
              ],
              "catalog_item_id": "gid://shopify/Product/8471",
              "catalog_item_kind": "product",
              "item_count": 4,
              "line_count": 3,
              "discount_used": true,
              "discount_amount_minor": 1000,
              "sales_channel": "online_store",
              "customer_order_count": 3
            }
          },
          "subject": {
            "authority": "namespace_authoritative",
            "source_subject_id": "8842001"
          },
          "correlation": {
            "occurrence_key": "shopify:orders/paid:b1f0"
          }
        },
        "consent": [],
