{
  "$schema": "../schemas/automatic.schema.json",
  "version": 1,
  "description": "The reserved automatic events (SPEC.md → Automatic events) and their conformance flows. `commonProperties` and `reserved` are the machine-readable catalogue: SDKs, the server, and the PR agent read the names from here. Each case runs on a harness that controls what the platform reports (`device`, and the app version and build on each `launch`), the lifecycle signals, and the SDK clock. A case starts on the storage named by `storage` (default `empty`); storage survives `terminate`. The values the harness cannot control are placeholders: `$platform` (bound to the SDK's own `platform`, and `os_name` carries the same value), `$sdk_name`, and `$sdk_version`; the harness substitutes its SDK's values and checks them against `commonProperties`. `launch` starts the process: the harness builds the client with the case `config` (automatic events on unless `config.automaticEvents` is false), calls identify('user_1') right after it, and then delivers the first foreground (a cold start). `background` and `foreground` move the harness clock forward by `afterMs` and then deliver that signal. `terminate` ends the process with no further signal. `screen` calls the SDK's manual screen API. `pushOpened` hands the notification data payload to the SDK's push-open API. The harness flushes after every step, then collects every event the case sent on /v1/events/batch and /v1/events/track, in send order, and asserts that they equal `expectedEvents`: the same `event_type` and exactly the same `properties`, after it removes identity fields, `occurred_at`, and `context` (context must still carry `$message_id`, as wire.json pins). Identify requests are not compared. An SDK whose lifecycle clock the harness cannot set checks instead that `foreground_ms` is a non-negative integer. SDKs that also implement automatic screen capture run these cases with it off. Every OTHER conformance harness (wire.json, behavior.json, push.json, anonymous.json) runs the SDK with automatic events disabled, so those fixtures see only the requests their steps cause.",
  "commonProperties": {
    "app_version": {
      "type": "string",
      "required": false,
      "description": "The user-facing app version (CFBundleShortVersionString, versionName, package version)."
    },
    "app_build": {
      "type": "string",
      "required": false,
      "description": "The build number as a string (CFBundleVersion, versionCode)."
    },
    "platform": {
      "type": "string",
      "required": true,
      "description": "The OS family, never the framework name: an iPad is ios, a React Native app on Android is android, a Flutter desktop app is macos, windows or linux. Readers treat any other value as other; the server never rejects an event for it.",
      "enum": [
        "ios",
        "android",
        "web",
        "macos",
        "windows",
        "linux"
      ],
      "placeholder": "$platform"
    },
    "os_name": {
      "type": "string",
      "required": true,
      "description": "The same lowercase OS family value as platform.",
      "enum": [
        "ios",
        "android",
        "web",
        "macos",
        "windows",
        "linux"
      ],
      "placeholder": "$platform"
    },
    "os_version": {
      "type": "string",
      "required": false,
      "description": "The operating system version as the platform reports it, for example 18.2 or 15."
    },
    "sdk_name": {
      "type": "string",
      "required": true,
      "description": "The SDK that sent the event.",
      "enum": [
        "whisperr-swift",
        "whisperr-flutter",
        "whisperr-react-native",
        "whisperr-web"
      ],
      "placeholder": "$sdk_name"
    },
    "sdk_version": {
      "type": "string",
      "required": true,
      "description": "The SDK release version, for example 1.8.0.",
      "placeholder": "$sdk_version"
    },
    "locale": {
      "type": "string",
      "required": false,
      "description": "BCP 47 language tag of the device, for example de-DE."
    },
    "timezone": {
      "type": "string",
      "required": false,
      "description": "IANA time zone name of the device, for example Europe/Berlin. Never an abbreviation or an offset."
    },
    "timezone_offset_minutes": {
      "type": "integer",
      "required": false,
      "description": "Minutes east of UTC at send time, for example 120. Sent only when the IANA name is unknown; never together with timezone."
    }
  },
  "reserved": [
    {
      "name": "app_installed",
      "trigger": "First launch of an install: no stored app version and no earlier SDK state.",
      "automatic": "always",
      "countsAsActivity": false,
      "properties": {
        "app_version": {
          "type": "string",
          "required": true,
          "description": "Installed app version."
        },
        "app_build": {
          "type": "string",
          "required": true,
          "description": "Installed build."
        }
      }
    },
    {
      "name": "app_updated",
      "trigger": "A launch where the app version or build differs from the stored one.",
      "automatic": "always",
      "countsAsActivity": false,
      "properties": {
        "app_version": {
          "type": "string",
          "required": true,
          "description": "New app version."
        },
        "app_build": {
          "type": "string",
          "required": true,
          "description": "New build."
        },
        "previous_version": {
          "type": "string",
          "required": true,
          "description": "The stored app version before this launch."
        },
        "previous_build": {
          "type": "string",
          "required": true,
          "description": "The stored build before this launch."
        }
      }
    },
    {
      "name": "app_opened",
      "trigger": "Every move to the foreground, including the cold start.",
      "automatic": "always",
      "countsAsActivity": true,
      "properties": {
        "cold_start": {
          "type": "boolean",
          "required": true,
          "description": "true for the first foreground of the process, false for a return from the background."
        }
      }
    },
    {
      "name": "app_backgrounded",
      "trigger": "Every move to the background.",
      "automatic": "always",
      "countsAsActivity": false,
      "properties": {
        "foreground_ms": {
          "type": "integer",
          "required": true,
          "description": "Milliseconds since the matching app_opened."
        }
      }
    },
    {
      "name": "screen_viewed",
      "trigger": "The app calls the SDK screen API, or a framework navigation hook the SDK installs.",
      "automatic": "framework",
      "countsAsActivity": true,
      "properties": {
        "screen_name": {
          "type": "string",
          "required": true,
          "description": "The screen name the app or the navigation framework gives."
        }
      }
    },
    {
      "name": "push_opened",
      "trigger": "The user opens a notification whose data carries whisperr_message_id.",
      "automatic": "framework",
      "countsAsActivity": true,
      "properties": {
        "whisperr_message_id": {
          "type": "string",
          "required": true,
          "description": "Copied from the notification data."
        },
        "deep_link": {
          "type": "string",
          "required": false,
          "description": "Copied from the notification data when present."
        }
      }
    }
  ],
